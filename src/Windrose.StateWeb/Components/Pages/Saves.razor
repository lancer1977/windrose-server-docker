@page "/saves"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.SignalR.Client
@using Windrose.StateWeb.Hubs
@inject IWindroseStateStore Store
@inject NavigationManager NavigationManager
@inject ILogger<Saves> Logger
@implements IAsyncDisposable

<MudStack Spacing="3">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudText Typo="Typo.h4">Saves</MudText>
        <MudStack AlignItems="AlignItems.End" Spacing="0">
            <MudText Typo="Typo.caption">Last update: @_lastUpdate.ToLocalTime().ToString("HH:mm:ss")</MudText>
            <MudText Typo="Typo.caption">Hub: @_hubStatus</MudText>
        </MudStack>
    </MudStack>
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-3">Latest Backup</MudText>
                <MudSimpleTable Dense="true">
                    <tbody>
                        <tr><td>Active Island</td><td class="mono">@(save.ActiveIslandId ?? state.CurrentIslandId ?? "-")</td></tr>
                        <tr><td>World Island</td><td class="mono">@(save.WorldIslandId ?? "-")</td></tr>
                        <tr><td>World Name</td><td>@(save.WorldName ?? "-")</td></tr>
                        <tr><td>World Preset</td><td>@(save.WorldPresetType ?? "-")</td></tr>
                        <tr><td>Checkpoint Format</td><td>@(save.CheckpointContainerFormat ?? "-")</td></tr>
                        <tr><td>Latest Backup</td><td class="mono">@(save.LatestBackupPath ?? "-")</td></tr>
                        <tr><td>Backup Time</td><td>@(save.LatestBackupTime?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</td></tr>
                        <tr><td>Backup Size</td><td>@(save.LatestBackupSizeBytes is null ? "-" : $"{save.LatestBackupSizeBytes / 1024 / 1024:N1} MB")</td></tr>
                        <tr><td>World Settings</td><td>@WorldSettingsLabel()</td></tr>
                        <tr><td>Error</td><td>@(save.Error ?? "-")</td></tr>
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-3">Save Collections</MudText>
                <MudTable Items="save.CollectionSummaries" Dense="true" Hover="true">
                    <HeaderContent>
                        <MudTh>Name</MudTh>
                        <MudTh>Count</MudTh>
                        <MudTh>Total Size</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Name</MudTd>
                        <MudTd>@context.Count</MudTd>
                        <MudTd>@($"{context.TotalBytes / 1024d / 1024d:N1} MB")</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudItem>
        <MudItem xs="12">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-3">Inspectable JSON Documents</MudText>
                <MudTable Items="save.DocumentSummaries" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                    <HeaderContent>
                        <MudTh>Kind</MudTh>
                        <MudTh>Path</MudTh>
                        <MudTh>Size</MudTh>
                        <MudTh>Scalars</MudTh>
                        <MudTh>Objects</MudTh>
                        <MudTh>Arrays</MudTh>
                        <MudTh>Preview</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Kind</MudTd>
                        <MudTd Class="mono">@context.Path</MudTd>
                        <MudTd>@(context.SizeBytes is null ? "-" : $"{context.SizeBytes / 1024d:N1} KB")</MudTd>
                        <MudTd>@context.ScalarPropertyCount</MudTd>
                        <MudTd>@context.ObjectCount</MudTd>
                        <MudTd>@context.ArrayCount</MudTd>
                        <MudTd Class="text-wrap">@Preview(context)</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudItem>
        <MudItem xs="12">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-3">Checkpoint Entries</MudText>
                <MudTable Items="save.CheckpointEntries.Take(12)" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                    <HeaderContent>
                        <MudTh>Kind</MudTh>
                        <MudTh>Path</MudTh>
                        <MudTh>Size</MudTh>
                        <MudTh>Markers</MudTh>
                        <MudTh>Tokens</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Kind</MudTd>
                        <MudTd Class="mono">@context.Path</MudTd>
                        <MudTd>@($"{context.SizeBytes / 1024d:N1} KB")</MudTd>
                        <MudTd Class="text-wrap">@string.Join(", ", context.Markers.Take(6))</MudTd>
                        <MudTd Class="text-wrap">@string.Join(", ", context.ReadableTokens.Take(6))</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudItem>
        <MudItem xs="12">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-3">Observed Families</MudText>
                <MudTable Items="save.ObservedFamilies" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                    <HeaderContent>
                        <MudTh>Name</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Notes</MudTh>
                        <MudTh>Evidence</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Name</MudTd>
                        <MudTd>@context.Status</MudTd>
                        <MudTd Class="text-wrap">@context.Notes</MudTd>
                        <MudTd Class="text-wrap">@string.Join(", ", context.Evidence)</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudStack>

@code {
    private WindroseServerState state = new();
    private SaveMetadata save = new();
    private DateTimeOffset _lastUpdate = DateTimeOffset.Now;
    private HubConnection? _hubConnection;
    private string _hubStatus = "connecting";
    private bool _disposed;
    private bool _connectedToHub;
    private CancellationTokenSource? _lifetimeCts;

    protected override void OnInitialized()
    {
        Refresh();
        _lifetimeCts = new CancellationTokenSource();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _connectedToHub)
        {
            return;
        }

        _connectedToHub = true;
        await ConnectToHubAsync();
    }

    private async Task ConnectToHubAsync()
    {
        var hubUrl = NavigationManager.ToAbsoluteUri("/hubs/windrose-state");

        try
        {
            _hubConnection = new HubConnectionBuilder()
                .WithUrl(hubUrl)
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On<WindroseStateChange>(nameof(IWindroseStateHubClient.WindroseStateUpdate), HandleStateChangeAsync);
            _hubConnection.Reconnecting += HandleReconnectingAsync;
            _hubConnection.Reconnected += HandleReconnectedAsync;
            _hubConnection.Closed += HandleClosedAsync;

            _hubStatus = "connecting";
            await InvokeAsync(StateHasChanged);

            await _hubConnection.StartAsync(_lifetimeCts!.Token);
            _hubStatus = "live";
            Logger.LogInformation("Connected Saves to Windrose state hub at {HubUrl}", hubUrl);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _hubStatus = "unavailable";
            Logger.LogWarning(ex, "Failed to connect Saves to Windrose state hub at {HubUrl}", hubUrl);
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task HandleStateChangeAsync(WindroseStateChange change)
    {
        if (_disposed)
        {
            return Task.CompletedTask;
        }

        state = change.State;
        save = state.Save;
        _lastUpdate = change.Timestamp;
        return InvokeAsync(StateHasChanged);
    }

    private Task HandleReconnectingAsync(Exception? _)
    {
        if (_disposed)
        {
            return Task.CompletedTask;
        }

        _hubStatus = "reconnecting";
        return InvokeAsync(StateHasChanged);
    }

    private Task HandleReconnectedAsync(string? _)
    {
        if (_disposed)
        {
            return Task.CompletedTask;
        }

        _hubStatus = "live";
        return InvokeAsync(StateHasChanged);
    }

    private Task HandleClosedAsync(Exception? _)
    {
        if (_disposed)
        {
            return Task.CompletedTask;
        }

        _hubStatus = "disconnected";
        return InvokeAsync(StateHasChanged);
    }

    private void Refresh()
    {
        state = Store.GetState();
        save = state.Save;
        _lastUpdate = DateTimeOffset.Now;
    }

    private string WorldSettingsLabel()
    {
        if (save.WorldSettingCount is null)
        {
            return "-";
        }

        return $"{save.WorldSettingCount} total ({save.WorldBoolSettingCount ?? 0} bool, {save.WorldFloatSettingCount ?? 0} float, {save.WorldTagSettingCount ?? 0} tag)";
    }

    private static string Preview(SaveDocumentSummary summary)
    {
        if (summary.ScalarPreview.Count == 0)
        {
            return summary.Notes ?? "-";
        }

        return string.Join("; ", summary.ScalarPreview.Take(3).Select(pair => $"{pair.Key}: {pair.Value}"));
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _lifetimeCts?.Cancel();

        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }

        _lifetimeCts?.Dispose();
    }
}
