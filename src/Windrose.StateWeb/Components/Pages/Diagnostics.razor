@page "/diagnostics"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.SignalR.Client
@using Windrose.StateWeb.Hubs
@inject IWindroseStateStore Store
@inject Microsoft.Extensions.Options.IOptions<Windrose.StateWeb.Options.WindroseStateOptions> Options
@inject NavigationManager NavigationManager
@inject ILogger<Diagnostics> Logger
@implements IAsyncDisposable

@{
    var options = Options.Value;
}

<MudStack Spacing="3" Class="dashboard-shell">
    <MudPaper Class="pa-5 dashboard-hero" Elevation="0">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
            <MudStack Spacing="1">
                <MudText Typo="Typo.h4">Diagnostics</MudText>
                <MudText Typo="Typo.body2">
                    Health, paths, and live-push settings for the state sidecar.
                </MudText>
            </MudStack>
            <MudStack AlignItems="AlignItems.End" Spacing="0">
                <MudText Typo="Typo.caption">Last update: @_lastUpdate.ToLocalTime().ToString("HH:mm:ss")</MudText>
                <MudText Typo="Typo.caption">Hub: @_hubStatus</MudText>
            </MudStack>
        </MudStack>
    </MudPaper>
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4 panel-card" Elevation="0">
                <MudText Typo="Typo.h6" Class="mb-3">Parser</MudText>
                <MudSimpleTable Dense="true">
                    <tbody>
                        <tr><td>Status</td><td>@state.ParserStatus</td></tr>
                        <tr><td>Log Available</td><td>@state.LogAvailable</td></tr>
                        <tr><td>Last Log Read</td><td>@(state.LastLogRead?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</td></tr>
                        <tr><td>Last Event</td><td>@(state.LastEventAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</td></tr>
                        <tr><td>Error</td><td>@(state.ParserError ?? "-")</td></tr>
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4 panel-card" Elevation="0">
                <MudText Typo="Typo.h6" Class="mb-3">Paths</MudText>
                <MudSimpleTable Dense="true">
                    <tbody>
                        <tr><td>Server Files</td><td class="mono">@options.ServerFilesPath</td></tr>
                        <tr><td>Log Path</td><td class="mono">@options.LogPath</td></tr>
                        <tr><td>Save Root</td><td class="mono">@options.SaveRootPath</td></tr>
                        <tr><td>Server Description</td><td class="mono">@options.ServerDescriptionPath</td></tr>
                        <tr><td>Event Retention</td><td>@options.EventRetention</td></tr>
                        <tr><td>SignalR Push</td><td>@(options.EnableChannelCheevosPush ? "Enabled" : "Disabled")</td></tr>
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        </MudItem>
        <MudItem xs="12">
            <MudPaper Class="pa-4 panel-card" Elevation="0">
                <MudText Typo="Typo.h6" Class="mb-3">Live Push Configuration</MudText>
                <MudSimpleTable Dense="true">
                    <tbody>
                        <tr><td>Target</td><td>@options.ResolvedChannelCheevosTarget</td></tr>
                        <tr><td>Hub URL</td><td class="mono">@(options.ResolveChannelCheevosHubUrl() ?? "-")</td></tr>
                        <tr><td>Webkey Set</td><td>@(!string.IsNullOrWhiteSpace(options.ResolveChannelCheevosWebKey()))</td></tr>
                        <tr><td>State Method</td><td>@options.ChannelCheevosStateMethod</td></tr>
                        <tr><td>Event Method</td><td>@options.ChannelCheevosEventMethod</td></tr>
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudStack>

@code {
    private WindroseServerState state = new();
    private DateTimeOffset _lastUpdate = DateTimeOffset.Now;
    private HubConnection? _hubConnection;
    private string _hubStatus = "connecting";
    private bool _disposed;
    private bool _connectedToHub;
    private CancellationTokenSource? _lifetimeCts;

    protected override void OnInitialized()
    {
        state = Store.GetState();
        _lastUpdate = DateTimeOffset.Now;
        _lifetimeCts = new CancellationTokenSource();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _connectedToHub)
        {
            return;
        }

        _connectedToHub = true;
        await ConnectToHubAsync();
    }

    private async Task ConnectToHubAsync()
    {
        var hubUrl = NavigationManager.ToAbsoluteUri("/hubs/windrose-state");

        try
        {
            _hubConnection = new HubConnectionBuilder()
                .WithUrl(hubUrl)
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On<WindroseStateChange>(nameof(IWindroseStateHubClient.WindroseStateUpdate), HandleStateChangeAsync);
            _hubConnection.Reconnecting += HandleReconnectingAsync;
            _hubConnection.Reconnected += HandleReconnectedAsync;
            _hubConnection.Closed += HandleClosedAsync;

            _hubStatus = "connecting";
            await InvokeAsync(StateHasChanged);

            await _hubConnection.StartAsync(_lifetimeCts!.Token);
            _hubStatus = "live";
            Logger.LogInformation("Connected Diagnostics to Windrose state hub at {HubUrl}", hubUrl);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _hubStatus = "unavailable";
            Logger.LogWarning(ex, "Failed to connect Diagnostics to Windrose state hub at {HubUrl}", hubUrl);
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task HandleStateChangeAsync(WindroseStateChange change)
    {
        if (_disposed)
        {
            return Task.CompletedTask;
        }

        state = change.State;
        _lastUpdate = change.Timestamp;
        return InvokeAsync(StateHasChanged);
    }

    private Task HandleReconnectingAsync(Exception? _)
    {
        if (_disposed)
        {
            return Task.CompletedTask;
        }

        _hubStatus = "reconnecting";
        return InvokeAsync(StateHasChanged);
    }

    private Task HandleReconnectedAsync(string? _)
    {
        if (_disposed)
        {
            return Task.CompletedTask;
        }

        _hubStatus = "live";
        return InvokeAsync(StateHasChanged);
    }

    private Task HandleClosedAsync(Exception? _)
    {
        if (_disposed)
        {
            return Task.CompletedTask;
        }

        _hubStatus = "disconnected";
        return InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _lifetimeCts?.Cancel();

        if (_hubConnection is not null)
        {
            await _hubConnection.DisposeAsync();
        }

        _lifetimeCts?.Dispose();
    }
}
