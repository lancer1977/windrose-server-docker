<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <PackageId>Windrose.StateWeb.Core</PackageId>
    <VersionPrefix>0.1.1</VersionPrefix>
    <Authors>indifferentbroccoli</Authors>
    <Title>Windrose State Web Core</Title>
    <Description>Reusable Windrose state payloads, contracts, and helper abstractions.</Description>
    <PackageTags>windrose;state-web;contracts;overlay;signalr</PackageTags>
    <PackageProjectUrl>https://github.com/indifferentbroccoli/windrose-server-docker</PackageProjectUrl>
    <RepositoryUrl>https://github.com/indifferentbroccoli/windrose-server-docker</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <NoWarn>1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
